{
  "manifest_version": "0.3",
  "name": "cookidoo-pp-mcp",
  "display_name": "Cookidoo",
  "version": "0.1.0",
  "description": "Read-only Cookidoo MCP server for public recipe data and local recipe analysis.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/cookidoo-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/cookidoo-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
