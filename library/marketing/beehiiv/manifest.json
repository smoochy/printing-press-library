{
  "manifest_version": "0.3",
  "name": "beehiiv-pp-mcp",
  "display_name": "Beehiiv",
  "version": "4.31.1",
  "description": "Printing Press CLI for Beehiiv.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/beehiiv-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/beehiiv-pp-mcp",
      "args": [],
      "env": {
        "PRINTING_PRESS_CLIENT_PROFILE": "${user_config.printing_press_client_profile}",
        "BEEHIIV_API_KEY": "${user_config.beehiiv_api_key}"
      }
    }
  },
  "user_config": {
    "printing_press_client_profile": {
      "type": "string",
      "title": "Client profile",
      "description": "Binds the MCP server to an existing tenant-gated Printing Press client profile.",
      "required": false
    },
    "beehiiv_api_key": {
      "type": "string",
      "title": "Beehiiv API key",
      "description": "Bearer token from app.beehiiv.com (Settings > API Keys). Required for all Beehiiv API calls.",
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}